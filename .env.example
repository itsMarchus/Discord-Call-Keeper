# ============================================================
# Discord Call Keeper - Environment Configuration Template
# ============================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your actual '.env' file to GitHub or any public repo!

# 1. Your Discord Bot Token (from Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=your_bot_token_here

# 2. Server (Guild) ID where the voice channel is located
# Enable Developer Mode in Discord > Right-click server icon > Copy Server ID
GUILD_ID=123456789012345678

# 3. Voice Channel ID the bot should join and sustain 24/7
# Enable Developer Mode in Discord > Right-click voice channel > Copy Channel ID
CHANNEL_ID=123456789012345678

# 4. HTTP Server Port (Render automatically sets process.env.PORT, default: 3000)
PORT=3000
